# --- required ---
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# value of the `luma.auth-session-key` cookie from a logged-in luma.com account that can see the guest list
LUMA_COOKIE=usr-xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LUMA_EVENT_URL=https://luma.com/claude-z01j?tk=63zU5x
# destination hidden behind the one-time redirect (decoded from promo QR)
PROMO_URL=https://example.com/redeem/XXXX
# openssl rand -hex 32
LINK_SECRET=
# openssl rand -hex 16
ADMIN_KEY=

# --- optional ---
EVENT_NAME=Bhopal | Claude Code Build Day - Fable 5.1
WIFI_SSID=
WIFI_PASSWORD=
# always | when_available | never
REQUIRE_HANDLE=when_available
SYNC_INTERVAL_MIN=10
SYNC_ON_BOOT=0
RECLAIM_GRACE_SEC=180
DATA_DIR=./data
ASSETS_DIR=./assets
PORT=3000

# seed roster from a CSV on first boot (optional)
ROSTER_CSV=./samples/guests.sample.csv
